import from ..services.events { Event, list_events, reserve_ticket }
import from ..services.student_verification { member_has_access, member_university }
import from .ui.card { Card, CardContent }
import from .ui.button { Button }
import from .ui.badge { Badge }
import from .ui.dialog { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription, DialogTrigger }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Calendar01Icon, Clock01Icon, Location01Icon, Search01Icon, ArrowRight01Icon, Ticket01Icon, Video01Icon }
import from "@jac/runtime" { Link }

def:pub EventDiscovery() -> JsxElement {
    has events: list[Event] = [];
    has selected_category: str = "All events";
    has selected_sport: str = "All sports";
    has selected_status: str = "Upcoming";
    has user_university: str = "University of Colombo";
    has has_access: bool = False;
    has selected_event: Event | None = None;
    has feedback: str = "";
    has loading: bool = True;

    async can with entry {
        events = await list_events();
        application_id = localStorage.getItem("uv_application_id") or "";
        if application_id != "" {
            user_university = await member_university(application_id);
            has_access = await member_has_access(application_id);
        }
        loading = False;
    }

    def handle_reserve(e: MouseEvent) {
        if selected_event is not None {
            async def _reserve() {
                feedback = await reserve_ticket(selected_event.id);
                events = await list_events();
            }
            _reserve();
        }
    }

    visible_events = [event for event in events if (selected_category == "All events" or event.category == selected_category) and (selected_category != "Sports" or selected_sport == "All sports" or event.sport == selected_sport) and (selected_category == "Merch" or selected_status == "Live" and event.live or selected_status == "Upcoming" and event.event_date >= "2026-10-17" or selected_status == "Finished" and event.event_date < "2026-10-17")];
    my_events = [event for event in events if event.university == user_university];

    return <main className="min-h-screen bg-muted/40">
        <header className="sticky top-0 z-20 border-b border-border/70 bg-background/90 backdrop-blur"><div className="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8"><Link to="/" className="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span className="text-[#090a47]">Uni</span><span className="text-[#6e101d]">Verse</span></Link><nav className="hidden items-center gap-7 text-sm font-medium text-muted-foreground md:flex"><a className="text-foreground" href="#events">Discover</a>{has_access and <a href="#university">My university</a>}{has_access and <Link to="/universities">Other Universities</Link>}</nav><div className="flex items-center gap-3"><Link to="/apply" className="hidden rounded-full border px-4 py-2 text-sm font-semibold sm:inline-flex">Create account</Link><Link to="/universe-admin" className="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-primary-foreground">Admin</Link></div></div></header>
        <div id="top" className="mx-auto max-w-7xl px-5 pb-16 pt-8 sm:px-8 sm:pt-12">
            <section className="relative overflow-hidden rounded-[2rem] bg-[#172a4d] px-7 py-10 text-white shadow-xl sm:px-12 sm:py-14"><div className="pointer-events-none absolute -right-12 -top-24 size-80 rounded-full bg-blue-400/20 blur-3xl"></div><div className="pointer-events-none absolute bottom-[-120px] right-1/3 size-72 rounded-full bg-rose-400/15 blur-3xl"></div><div className="relative grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]"><div className="flex max-w-2xl flex-col gap-6"><Badge className="w-fit rounded-full border-white/20 bg-white/10 px-3 py-1 text-white hover:bg-white/10">YOUR CAMPUS, OUT THERE</Badge><h1 className="text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">Make your university days <span className="text-rose-300">count.</span></h1><p className="max-w-lg text-base leading-relaxed text-blue-100 sm:text-lg">Find the talks, match days and nights out happening around your campus.</p><div className="flex flex-wrap gap-3"><a href="#events" className="inline-flex h-11 items-center gap-2 rounded-full bg-white px-5 text-sm font-semibold text-[#172a4d]">Explore events <HugeiconsIcon icon={ArrowRight01Icon} strokeWidth={2} className="size-4" /></a><a href="#university" className="inline-flex h-11 items-center rounded-full border border-white/30 px-5 text-sm font-medium text-white">My university</a></div><p className="text-sm text-blue-100">Made for campus life in Sri Lanka</p></div><div className="hidden lg:block"><div className="rotate-2 overflow-hidden rounded-3xl border border-white/15 bg-white/10 p-4 shadow-2xl"><div className="rounded-2xl bg-gradient-to-br from-sky-300 via-blue-400 to-indigo-700 p-8"><p className="text-xs font-semibold uppercase tracking-widest text-white/80">CAMPUS HIGHLIGHT</p><p className="mt-3 text-3xl font-bold text-white">Ideas that shape tomorrow</p></div><div className="rounded-b-2xl bg-white p-5 text-slate-900"><p className="font-semibold">Future of AI</p><p className="text-sm text-slate-500">New Arts Theatre · Colombo</p></div></div></div></div></section>
            <section id="events" className="scroll-mt-24 pt-14"><div className="flex flex-wrap items-end justify-between gap-4"><div><p className="text-sm font-semibold text-primary">THE CAMPUS CALENDAR</p><h2 className="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Happening soon</h2><p className="mt-2 text-muted-foreground">Good things are happening around your university.</p></div><a href="#organizers" className="text-sm font-semibold text-primary">Promote an event</a></div>
                <div className="mt-7 flex flex-col gap-3">
                    {selected_category != "Merch" and <div className="flex flex-wrap gap-2">{for state in ["Live", "Upcoming", "Finished"] {<button key={state} onClick={lambda (e: MouseEvent) { selected_status = state; }} className={"rounded-full border px-3 py-2 text-xs font-semibold " + ("border-emerald-300 bg-emerald-100 text-emerald-800" if selected_status == state else "bg-card text-muted-foreground")}>{state}</button>}}</div>}
                    <div className="flex flex-wrap items-center gap-2">{for category in ["All events", "Educational", "Sports", "Entertainment", "Merch"] {<button key={category} onClick={lambda (e: MouseEvent) { selected_category = category; selected_sport = "All sports"; }} className={"rounded-full px-4 py-2 text-sm font-medium " + ("bg-[#172a4d] text-white" if selected_category == category else "border border-border bg-card text-muted-foreground")}>{category}</button>}}</div>
                    {selected_category == "Sports" and <div className="flex flex-wrap gap-2">{for sport in ["All sports", "Basketball", "Rugby"] {<button key={sport} onClick={lambda (e: MouseEvent) { selected_sport = sport; }} className={"rounded-full px-3 py-2 text-xs font-medium " + ("bg-rose-100 text-rose-800" if selected_sport == sport else "bg-card text-muted-foreground")}>{sport}</button>}}</div>}
                </div>
                <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{if loading {<Card className="col-span-full p-10 text-center text-muted-foreground">Loading upcoming campus events…</Card>; skip;}}{if len(visible_events) == 0 {<Card className="col-span-full border-dashed py-12 text-center"><CardContent><div className="mx-auto flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary"><HugeiconsIcon icon={Search01Icon} strokeWidth={2} /></div><h3 className="mt-3 text-lg font-semibold">No events match these filters</h3><p className="mt-1 text-sm text-muted-foreground">Try another date or campus filter.</p></CardContent></Card>; skip;}}
                    {for event in visible_events {<Dialog key={event.id}><DialogTrigger><button onClick={lambda (e: MouseEvent) { selected_event = event; feedback = ""; }} className="group block w-full cursor-pointer overflow-hidden rounded-2xl border border-border/70 bg-card text-left shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"><div className={"relative flex h-36 items-end overflow-hidden bg-cover bg-center p-5 " + ("bg-gradient-to-br from-sky-200 via-blue-400 to-indigo-800" if event.thumbnail == "" and event.accent == "blue" else "bg-gradient-to-br from-orange-200 via-rose-400 to-red-700" if event.thumbnail == "" and event.accent == "coral" else "bg-gradient-to-br from-violet-200 via-fuchsia-400 to-purple-800" if event.thumbnail == "" and event.accent == "purple" else "bg-gradient-to-br from-emerald-200 via-teal-400 to-green-800" if event.thumbnail == "" else "")} style={{"backgroundImage": "url(" + event.thumbnail + ")"}}><span className="relative rounded-xl bg-white/95 px-3 py-2 text-xs font-bold text-slate-900">{event.date_label}</span><Badge className="absolute right-4 top-4 rounded-full bg-white/90 text-slate-800">{event.category}</Badge>{event.live and <span className="absolute bottom-5 right-5 rounded-full bg-emerald-950/75 px-2.5 py-1 text-xs font-medium text-white">Live access</span>}</div><CardContent className="flex flex-col gap-4 p-5"><div><h3 className="text-lg font-semibold group-hover:text-primary">{event.title}</h3><p className="mt-1 text-sm text-muted-foreground">{event.university}</p></div><div className="flex flex-col gap-2 text-sm text-muted-foreground"><span className="flex items-center gap-2"><HugeiconsIcon icon={Clock01Icon} strokeWidth={2} className="size-4 text-primary" />{event.date_label} · {event.time}</span><span className="flex items-center gap-2"><HugeiconsIcon icon={Location01Icon} strokeWidth={2} className="size-4 text-primary" />{event.venue}</span></div><div className="flex items-center justify-between border-t pt-4"><span className="font-semibold">{"LKR " + str(event.price) if event.category == "Merch" and event.price > 0 else "Free entry" if event.category == "Educational" or event.price == 0 else "LKR " + str(event.price)}</span>{event.category == "Merch" and <a href={event.buy_url if event.buy_url != "" else "mailto:hello@universe.lk?subject=Merch%20order"} target="_blank" rel="noreferrer" className="rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">Buy</a>}{event.category != "Merch" and event.category != "Educational" and <span className="text-xs text-muted-foreground">Ticket reservation available</span>}</div>{event.category == "Merch" and event.deadline != "" and <p className="text-xs text-muted-foreground">Order by {event.deadline}</p>}</CardContent></button></DialogTrigger><DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-lg"><DialogHeader><DialogTitle className="text-2xl">{event.title}</DialogTitle><DialogDescription>{event.university} · {event.category}</DialogDescription></DialogHeader><div className="flex flex-col gap-5"><p className="leading-relaxed text-muted-foreground">{event.description}</p>{event.additional_info != "" and <div className="whitespace-pre-wrap rounded-xl bg-muted/50 p-4 text-sm leading-relaxed">{event.additional_info}</div>}<div className="grid grid-cols-2 gap-3 rounded-xl bg-muted/60 p-4 text-sm"><div className="flex gap-2"><HugeiconsIcon icon={Calendar01Icon} strokeWidth={2} className="size-4 text-primary" /><span>{event.date_label}</span></div><div className="flex gap-2"><HugeiconsIcon icon={Clock01Icon} strokeWidth={2} className="size-4 text-primary" /><span>{event.time}</span></div><div className="col-span-2 flex gap-2"><HugeiconsIcon icon={Location01Icon} strokeWidth={2} className="size-4 text-primary" /><span>{event.venue}</span></div></div>{event.live and <a href={event.zoom_url} target="_blank" className="flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm font-medium text-emerald-800"><HugeiconsIcon icon={Video01Icon} strokeWidth={2} className="size-4" />Online session link available</a>}<div className="flex items-center justify-between border-t pt-4"><div><p className="text-xs text-muted-foreground">{ "ORDER DEADLINE" if event.category == "Merch" else "TICKET PRICE" if event.category != "Educational" else "EVENT ENTRY" }</p><p className="text-xl font-semibold">{"LKR " + str(event.price) if event.category == "Merch" and event.price > 0 else event.deadline if event.category == "Merch" and event.deadline != "" else "Free entry" if event.category == "Educational" or event.price == 0 else "LKR " + str(event.price)}</p></div>{event.category == "Merch" and <a href={event.buy_url} target="_blank" rel="noreferrer" className="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground">Buy</a>}{event.category == "Educational" and <span className="text-sm font-medium text-muted-foreground">Date, time and location only</span>}{event.category != "Merch" and event.category != "Educational" and <Button onClick={handle_reserve} className="rounded-full px-5"><HugeiconsIcon icon={Ticket01Icon} strokeWidth={2} className="size-4" />Reserve ticket</Button>}</div>{feedback and <p className="rounded-lg bg-emerald-50 p-3 text-sm font-medium text-emerald-800">{feedback}</p>}</div></DialogContent></Dialog>}}
                </div>
            </section>
            <section id="university" className="mt-16 rounded-3xl border border-border/70 bg-card p-6 shadow-sm sm:p-9">{if has_access {<div><p className="text-sm font-semibold text-primary">YOUR UNIVERSITY</p><h2 className="mt-2 text-2xl font-semibold tracking-tight">Upcoming at {user_university}</h2><p className="mt-2 text-sm text-muted-foreground">Your verified campus calendar.</p><div className="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{for event in my_events {<Card key={event.id} className="shadow-sm"><CardContent className="flex flex-col gap-2 p-4"><p className="text-xs font-semibold text-primary">{event.date_label} · {event.category}</p><h3 className="font-semibold">{event.title}</h3><p className="text-sm text-muted-foreground">{event.time} · {event.venue}</p></CardContent></Card>}}</div></div>} else {<div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><p className="text-sm font-semibold text-primary">YOUR CAMPUS, FIRST</p><h2 className="mt-2 text-2xl font-semibold tracking-tight">Unlock your university feed</h2><p className="mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground">Apply with your student ID, then complete membership payment after verification to access campus-specific events.</p></div><Link to="/apply" className="inline-flex h-10 shrink-0 items-center justify-center rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground">Create your account</Link></div>}}</section>
            <section id="organizers" className="mt-10 flex flex-col gap-4 rounded-3xl bg-rose-50 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"><div><h2 className="text-xl font-semibold tracking-tight text-slate-900">Bringing campus together?</h2><p className="mt-1 text-sm text-slate-600">Tell us about your event and we’ll help more students find it.</p></div><a href="mailto:hello@universe.lk?subject=Promote%20a%20campus%20event" className="inline-flex h-10 items-center justify-center rounded-full bg-[#172a4d] px-5 text-sm font-semibold text-white">Talk to our team</a></section>
            <footer className="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"><p><span className="font-semibold text-foreground">UniVerse</span> · Campus life, all in one place.</p><p>Colombo, Sri Lanka · <a href="mailto:hello@universe.lk" className="underline underline-offset-4">Contact us</a></p></footer>
        </div>
    </main>;
}
